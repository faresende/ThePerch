# scripts/.env.example
#
# Template for scripts/.env. Copy this file to scripts/.env and fill in real
# values. scripts/.env is gitignored; this template is committed.
#
# Usage:
#   cp scripts/.env.example scripts/.env
#   # then edit scripts/.env with real values

# Self-hosted Supabase project URL (no trailing slash).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key. Get from Supabase Dashboard → Settings → API.
# WARNING: bypasses RLS. Treat as a password. Never log it.
SUPABASE_SERVICE_ROLE_KEY=paste_your_service_role_key_here

# UUID of the user who owns the records created by this worker.
# Copy from Supabase Dashboard → Authentication → Users.
PERCH_USER_ID=00000000-0000-0000-0000-000000000000

# ─── Optional: Eight Sleep (private/reverse-engineered API) ───────────
# 8sleep does not officially support third-party API access. The
# integration extracts these app-identifying credentials from the
# official iOS app — they identify the app, not the user. Multiple
# community projects ship the same constants. They may break at any
# time when 8sleep ships a new app.
#
# Distributing these as part of a public binary may breach 8sleep's
# ToS. Use for personal data access only; don't redistribute as a
# service.
#
# If 8sleep eventually publishes an official API, switch to it and
# leave these blank.
EIGHT_SLEEP_CLIENT_ID=
EIGHT_SLEEP_CLIENT_SECRET=
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=

# scripts/.env.example
#
# Template for scripts/.env. Copy this file to scripts/.env and fill in real
# values. scripts/.env is gitignored; this template is committed.
#
# Usage:
#   cp scripts/.env.example scripts/.env
#   # then edit scripts/.env with real values

# Self-hosted Supabase project URL (no trailing slash).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key. Get from Supabase Dashboard → Settings → API.
# WARNING: bypasses RLS. Treat as a password. Never log it.
SUPABASE_SERVICE_ROLE_KEY=paste_your_service_role_key_here

# UUID of the user who owns the records created by this worker.
# Copy from Supabase Dashboard → Authentication → Users.
PERCH_USER_ID=00000000-0000-0000-0000-000000000000

# ─── Optional: Eight Sleep (private/reverse-engineered API) ───────────
# 8sleep does not officially support third-party API access. The
# integration extracts these app-identifying credentials from the
# official iOS app — they identify the app, not the user. Multiple
# community projects ship the same constants. They may break at any
# time when 8sleep ships a new app.
#
# Distributing these as part of a public binary may breach 8sleep's
# ToS. Use for personal data access only; don't redistribute as a
# service.
#
# If 8sleep eventually publishes an official API, switch to it and
# leave these blank.
EIGHT_SLEEP_CLIENT_ID=
EIGHT_SLEEP_CLIENT_SECRET=
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=

# ─── Optional: Oura (primary sleep source) ────────────────────────────
# Generate at https://cloud.ouraring.com/personal-access-tokens
OURA_PERSONAL_TOKEN=

# ─── Optional: Withings (fallback body composition source) ────────────
# Create a personal app at https://developer.withings.com/dashboard/
# and run withings_setup.py once for the OAuth handshake.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# ─── Optional: OpenAI (the LLM insight generator) ─────────────────────
# Used by biochecha_dynamic_insight.py + biochecha_post_wake_insight.py.
# Default model is gpt-4o-mini, ~$0.0001 per insight.
OPENAI_API_KEY=

# ─── Optional: 17track (shipment ETA polling) ─────────────────────────
# Sign up at https://api.17track.net/ for an API key. Free tier covers
# the typical personal-shipment volume.
SEVENTEEN_TRACK_API_KEY=

# ─── Optional: InBody H30 watcher ─────────────────────────────────────
# Override the default watch directory (~/Documents/InBody) if your
# LookinBody Connect export lands somewhere else.
INBODY_WATCH_DIR=

# ─── Optional: Telegram bot (post-wake briefings) ─────────────────────
# Used by _telegram_client.py for long-form post-wake briefings.
# Either set these env vars or put the equivalent under
# ~/.openclaw/secrets.json. PERCH_TELEGRAM_ACCOUNT defaults to
# "biochecha" — set it to whatever account label you've configured
# in your openclaw secrets.json.
PERCH_TELEGRAM_ACCOUNT=
PERCH_TELEGRAM_BOT_TOKEN=
PERCH_TELEGRAM_CHAT_ID=

# ─── Optional: TestFlight deploy (deploy-testflight.sh) ───────────────
# App Store Connect API key. Generate at
# https://appstoreconnect.apple.com/access/api. APPLE_KEY_ID is the
# 10-char alphanumeric key id; APPLE_ISSUER is the team's UUID.
# APPLE_KEY_PATH defaults to ~/.openclaw/secrets/AuthKey_<KEY_ID>.p8.
APPLE_KEY_ID=
APPLE_ISSUER=
APPLE_KEY_PATH=

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="LaunchVC-01">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen-->
        <scene sceneID="LaunchScene-01">
            <objects>
                <viewController id="LaunchVC-01" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="LaunchView-01">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Bird illustration, 220×220 -->
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="perch-bird-hero" translatesAutoresizingMaskIntoConstraints="NO" id="bird-01">
                                <rect key="frame" x="86.5" y="281" width="220" height="220"/>
                            </imageView>
                            <!-- Notification: outer bone ring, 34×34.
                                 SF Symbol circle.fill gives a true round
                                 shape without needing a runtime corner-
                                 radius attribute (blocked on launch
                                 screens). Tint = bone so the bird has a
                                 coloured hole cut out of its shoulder. -->
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="circle.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="ring-01">
                                <rect key="frame" x="254.5" y="309" width="34" height="34"/>
                                <color key="tintColor" name="LaunchBG"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="34" id="ring-w"/>
                                    <constraint firstAttribute="height" constant="34" id="ring-h"/>
                                </constraints>
                            </imageView>
                            <!-- Notification: inner terracotta dot, 20×20.
                                 Same technique. Glow shadow from the spec
                                 is dropped here — launch screens can't
                                 set layer.shadow via runtime attrs.
                                 Small loss; safe trade for native launch. -->
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="circle.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="dot-01">
                                <rect key="frame" x="261.5" y="316" width="20" height="20"/>
                                <color key="tintColor" red="0.882" green="0.290" blue="0.208" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="20" id="dot-w"/>
                                    <constraint firstAttribute="height" constant="20" id="dot-h"/>
                                </constraints>
                            </imageView>
                            <!-- Wordmark — rasterised "The Perch" in
                                 Fraunces italic 500. Shipped as a PNG
                                 because launch screens render before
                                 UIAppFonts registers custom fonts, so
                                 Fraunces can't be used as a live font
                                 here. The image carries the same bone
                                 background as the page so it blends
                                 seamlessly. Width matches the spec's
                                 40pt line × 5:1 glyph aspect. -->
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="launch-wordmark" translatesAutoresizingMaskIntoConstraints="NO" id="wordmark-01">
                                <rect key="frame" x="84.5" y="523" width="224" height="44"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safeArea-01"/>
                        <color key="backgroundColor" name="LaunchBG"/>
                        <constraints>
                            <!-- Bird sizing + centered horizontally -->
                            <constraint firstItem="bird-01" firstAttribute="width" constant="220" id="bird-w"/>
                            <constraint firstItem="bird-01" firstAttribute="height" constant="220" id="bird-h"/>
                            <constraint firstItem="bird-01" firstAttribute="centerX" secondItem="safeArea-01" secondAttribute="centerX" id="bird-cx"/>
                            <!-- Wordmark below bird with 22pt gap, centered horizontally.
                                 Fixed size so the PNG's aspect stays clean (5:1). -->
                            <constraint firstItem="wordmark-01" firstAttribute="width" constant="224" id="wm-w"/>
                            <constraint firstItem="wordmark-01" firstAttribute="height" constant="44" id="wm-h"/>
                            <constraint firstItem="wordmark-01" firstAttribute="centerX" secondItem="safeArea-01" secondAttribute="centerX" id="wm-cx"/>
                            <constraint firstItem="wordmark-01" firstAttribute="top" secondItem="bird-01" secondAttribute="bottom" constant="22" id="wm-top"/>
                            <!-- Group (bird + gap + wordmark) vertically centered in safe area.
                                 Offset = -(gap/2 + wordmarkHeight/2) = -(22/2 + 44/2) = -33 -->
                            <constraint firstItem="bird-01" firstAttribute="centerY" secondItem="safeArea-01" secondAttribute="centerY" constant="-33" id="bird-cy"/>
                            <!-- Notification ring: top 28, trailing 18 relative to bird frame -->
                            <constraint firstItem="ring-01" firstAttribute="top" secondItem="bird-01" secondAttribute="top" constant="28" id="ring-t"/>
                            <constraint firstItem="bird-01" firstAttribute="trailing" secondItem="ring-01" secondAttribute="trailing" constant="18" id="ring-r"/>
                            <!-- Inner dot centered on ring -->
                            <constraint firstItem="dot-01" firstAttribute="centerX" secondItem="ring-01" secondAttribute="centerX" id="dot-cx"/>
                            <constraint firstItem="dot-01" firstAttribute="centerY" secondItem="ring-01" secondAttribute="centerY" id="dot-cy"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FirstResponder-01" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="perch-bird-hero" width="220" height="220"/>
        <image name="launch-wordmark" width="224" height="44"/>
        <namedColor name="LaunchBG">
            <color red="0.961" green="0.910" blue="0.820" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>

// Secrets.example.xcconfig
//
// Template for Secrets.xcconfig. Copy this file to Secrets.xcconfig and
// fill in your own values. Secrets.xcconfig is gitignored; this
// template is committed.
//
// Usage:
//   cp ios/ThePerch/Sources/ThePerch/Config/Secrets.example.xcconfig \
//      ios/ThePerch/Sources/ThePerch/Config/Secrets.xcconfig
//
// Then edit Secrets.xcconfig with your values and build in Xcode.
//
// These values are for YOUR OWN Supabase project. If you only want to
// try the app briefly, you can leave placeholders here and use the
// in-app OnboardingView to enter URL + anon key at first launch; they
// will be stored in the Keychain.
//
// IMPORTANT: xcconfig files treat // as a comment delimiter, so URLs
// with https:// must use the $() empty-expansion trick to escape the
// double slash. Use the form:   https:/$()/host.example.com
// At build time this resolves to:  https://host.example.com

// ─── Your Supabase project ────────────────────────────────────────────────
// From Supabase Dashboard → Settings → API.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_OR_ANON_KEY

// ─── Karakeep (bookmarks API) ─────────────────────────────────────────────
// Only needed if you use the Bookmarks tab with a Karakeep instance.
KARAKEEP_TOKEN = YOUR_KARAKEEP_API_TOKEN

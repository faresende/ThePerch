// Secrets.example.xcconfig
//
// Template for Secrets.xcconfig. Copy this file to Secrets.xcconfig and fill
// in real values. Secrets.xcconfig is gitignored; this template is committed.
//
// Usage:
//   cp ios/ThePerch/Sources/ThePerch/Config/Secrets.example.xcconfig \
//      ios/ThePerch/Sources/ThePerch/Config/Secrets.xcconfig
//
// Then edit Secrets.xcconfig with real values and build in Xcode.
//
// IMPORTANT: xcconfig files treat // as a comment delimiter, so URLs with
// https:// must use the $() empty-expansion trick to escape the double
// slash. Use the form:   https:/$()/host.example.com
// At build time this resolves to:  https://host.example.com

// ─── Self-hosted / personal Supabase project ──────────────────────────────
// From Supabase Dashboard → Settings → API.
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_OR_ANON_KEY

// ─── Managed cloud Supabase project (only needed for ThePerch Cloud tier) ─
// Leave as placeholder if you only use the self-hosted backend.
SUPABASE_MANAGED_URL = https:/$()/YOUR-MANAGED-PROJECT-REF.supabase.co
SUPABASE_MANAGED_ANON_KEY = YOUR_MANAGED_PUBLISHABLE_KEY

// ─── Karakeep (bookmarks API) ─────────────────────────────────────────────
// Only needed if you use the Bookmarks tab.
KARAKEEP_TOKEN = YOUR_KARAKEEP_API_TOKEN

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Copy this file to Secrets.plist (which is .gitignored) and fill in your values.

         You can also set these via the app's onboarding screen — the app will
         write them to the system Keychain. This file is an alternative for
         dev convenience. -->

    <key>SUPABASE_URL</key>
    <string>https://YOUR-PROJECT-REF.supabase.co</string>

    <!-- The ANON key (also called publishable key). This is designed to be
         shipped with client apps; never use the service_role key here. -->
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_SUPABASE_ANON_KEY</string>

    <!-- Optional: only if you use Karakeep as a bookmarks source -->
    <key>KARAKEEP_TOKEN</key>
    <string></string>
</dict>
</plist>

# The Perch — environment variable reference
#
# Copy this file to .env (which is gitignored) and fill in the values you need.
# Not every skill needs every variable — check each skill's INSTALL.md for the
# subset that applies to it.
#
# The Perch does not read .env directly anywhere — this is just documentation.
# Your agent runtime, OS, or scripts are responsible for loading these into
# the processes that need them.

# ─── Supabase (required by almost everything) ─────────────────────────────────

# Your Supabase project URL. Get it from: Settings → API → Project URL.
SUPABASE_URL=https://<YOUR-PROJECT-REF>.supabase.co

# The ANON / PUBLIC key. Safe to ship with the iOS app. RLS will filter rows
# by the signed-in user. Get it from: Settings → API → anon / public.
SUPABASE_ANON_KEY=

# The SERVICE ROLE key. Bypasses RLS — agents use this to write on behalf of
# users. KEEP THIS SECRET. Never put it in a client-side app, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── The Perch user scope ─────────────────────────────────────────────────────

# Your Supabase auth.users UUID. Get it after signing up via:
#   SELECT id FROM auth.users ORDER BY created_at DESC LIMIT 1;
PERCH_USER_ID=

# ─── Optional, per-skill ──────────────────────────────────────────────────────

# perch-health (reference provider: Oura Ring)
#   Generate at https://cloud.ouraring.com/personal-access-tokens
OURA_PERSONAL_ACCESS_TOKEN=

# perch-bookmarks (optional Karakeep integration)
#   Only if you run a Karakeep instance. Leave blank to skip.
KARAKEEP_TOKEN=
KARAKEEP_BASE_URL=

# perch-orders (reference provider: Fastmail JMAP)
#   Consult the skill's INSTALL.md for how credentials are loaded —
#   typically via a provider-specific config file rather than env vars.

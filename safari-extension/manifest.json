{
  "manifest_version": 3,
  "name": "The Perch",
  "version": "1.0.0",
  "description": "Save bookmarks to The Perch",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "The Perch",
    "default_popup": "popup.html",
    "default_icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
